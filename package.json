{
  "name": "socialapi",
  "version": "0.0.0",
  "description": "Official TypeScript SDK for SocialAPI, generated from the OpenAPI spec",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/SocialAPI-AI/socialapi-typescript.git" },
  "homepage": "https://social-api.ai",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/client.test.mjs test/webhooks.test.mjs"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "5.9.3"
  }
}
